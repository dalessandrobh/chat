# =============================================================================
# Variáveis do n8n — cole no campo "Environment Variables" do recurso no Coolify
# =============================================================================
# As chaves abaixo foram geradas para este projeto. Trate-as como senha.

# Criptografa as credenciais dos workflows.
# ATENÇÃO: se perder esta chave, todas as credenciais salvas no n8n viram lixo.
N8N_ENCRYPTION_KEY=COLE-AQUI-UMA-CHAVE-DE-64-CARACTERES

# Nome do banco do n8n (usuário e senha o Coolify gera sozinho via
# SERVICE_USER_POSTGRES / SERVICE_PASSWORD_POSTGRES)
POSTGRES_DB=n8n

# --- Ponte com o painel Chat ---
# O n8n chama a API do painel em vez de falar direto com a Meta.
CHAT_API_URL=https://chat.dsearch.com.br
CHAT_SERVICE_TOKEN=COLE-AQUI-O-MESMO-CHAT_SERVICE_TOKEN-DO-PAINEL

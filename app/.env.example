# =============================================================================
# Painel Chat — variáveis de ambiente
# =============================================================================
# Copie para .env.local (desenvolvimento) ou cole no Coolify (produção).

# --- Supabase ---
# Pegue as chaves no Coolify > projeto Supabase > Environment Variables
# (SERVICE_SUPABASEANON_KEY e SERVICE_SUPABASESERVICE_KEY).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.dsearch.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedor de WhatsApp ---
# São dois, e nenhum é obrigatório no boot: preencha o bloco do provedor que
# vai usar. O canal cadastrado em chat.channels é quem decide qual atende cada
# número, então dá para rodar os dois em paralelo.

# --- Evolution API (não oficial, Baileys) ---
# Rede interna do Docker quando painel e Evolution estão no mesmo host.
EVOLUTION_BASE_URL=http://evolution-api:8080
# AUTHENTICATION_API_KEY do serviço Evolution (Coolify > Evolution > Env Vars).
EVOLUTION_API_KEY=
# Segredo NOSSO: a Evolution repete este bearer em todo webhook e o painel
# confere. Sem ele, quem descobrir a URL injeta mensagem falsa no inbox.
# Gere com: openssl rand -hex 32
EVOLUTION_WEBHOOK_TOKEN=

# --- Meta WhatsApp Cloud API (oficial) ---
# Todos vêm de developers.facebook.com > seu app > WhatsApp.
# Veja o passo a passo em docs/02-meta-cloud-api.md
META_API_VERSION=v21.0
# Token permanente do System User (NÃO o token temporário de 24h)
META_ACCESS_TOKEN=
# WhatsApp > API Setup > "Phone number ID"
META_PHONE_NUMBER_ID=
# WhatsApp > API Setup > "WhatsApp Business Account ID"
META_WABA_ID=
# App Settings > Basic > "App Secret". Valida a assinatura dos webhooks.
META_APP_SECRET=
# String que você inventa e repete no painel da Meta ao cadastrar o webhook.
META_WEBHOOK_VERIFY_TOKEN=

# --- Ponte com o n8n ---
# Mesmo valor configurado no n8n. Autentica /api/internal/*.
CHAT_SERVICE_TOKEN=
# Webhook do workflow de atendimento. O painel chama esta URL quando chega
# mensagem e a conversa está em modo bot.
N8N_WEBHOOK_URL=https://n8n.dsearch.com.br/webhook/chat-inbound
